@page
@model DevelopersHub.Pages.ForoModel
@{
    ViewData["Title"] = "Foro";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Foro.css">
}
<div class="d-flex flex-column min-vh-100">
    <partial name="_Navbar"></partial>

        <div class="fondo-gradiente d-flex flex-column flex-grow-1 py-5">
            <div class="container" style="max-width: 800px;">

                <!-- Encabezado con Botón -->
                <div class="d-flex justify-content-between align-items-center text-white mb-4">
                    <h3 class="mb-0 fw-bold">Bienvenido al foro</h3>
                    <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal"
                            data-bs-target="#publicacionModal">Crear publicación</button>
                </div>

                <!-- Lista de Publicaciones -->
                <div class="d-flex flex-column gap-3">

                    @if (Model.Publicaciones.Any())
                    {
                        foreach (var publicacion in Model.Publicaciones)
                        {
                            <div class="card-publicacion bg-white p-4 rounded-3 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary">@(publicacion.Usuario?.UserName)</span>
                                    <span class="badge bg-primary me-2" style="background-color: @(publicacion.Categoria?.ColorHexa)!important">@publicacion.Categoria?.Nombre</span>
                                    <small class="text-muted">@(publicacion.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</small>
                                </div>
                                <h5 class="fw-bold text-dark">@(publicacion.Titulo)</h5>
                                <p class="text-secondary mb-0">
                                    @(publicacion.Contenido)
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="bg-white p-4 rounded-3 shadow-sm text-center text-muted">
                            Aún no hay publicaciones. ¡Sé el primero en crear una!
                        </div>
                    }


                </div>
            </div>
        </div>
    </div>

<div class="modal fade" id="publicacionModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-light">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Nueva publicación</h1>
            </div>
            <div class="modal-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label d-block">Categoría</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var cat in Model.Categorias)
                            {
                                <input type="radio" class="btn-check" asp-for="Input.CategoriaId" value="@cat.Id"
                                       id="cat-@cat.Id" required>
                                <label class="btn btn-outline-secondary categoria-pill" for="cat-@cat.Id"
                                       style="--cat-color: @cat.ColorHexa;">
                                    @cat.Nombre
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Input.CategoriaId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Titulo" class="col-form-label">Título:</label>
                        <input asp-for="Input.Titulo" class="form-control" required />
                        <span asp-validation-for="Input.Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Contenido" class="col-form-label">Contenido:</label>
                        <textarea asp-for="Input.Contenido" class="form-control" rows="6" required></textarea>
                        <span asp-validation-for="Input.Contenido" class="text-danger small"></span>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Publicar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


